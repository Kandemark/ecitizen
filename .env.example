# ==============================================================================
# e-Citizen Kenya — Environment Variables Reference
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control — it contains secrets.
# ==============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
# SECRET_KEY: 50+ char random string. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key
# DEBUG: Set to False in production. Never True with real user data.
DEBUG=True
# ALLOWED_HOSTS: Comma-separated hostnames (no spaces). Add your domain in prod.
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
TIME_ZONE=Africa/Nairobi
LANGUAGE_CODE=en-ke

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL URL format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# SQLite is used when DATABASE_URL is unset or empty.
# For Docker: postgres://ecitizen:ecitizen_dev@db:5432/ecitizen
DATABASE_URL=postgres://ecitizen:ecitizen_dev@localhost:5432/ecitizen

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Redis URL format: redis://[USER:PASSWORD@]HOST:PORT[/DB]
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=4

# ── CORS / Security ──────────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS: Comma-separated absolute URLs (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
CSRF_TRUSTED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
SESSION_COOKIE_AGE=1209600
# Set both to True in production when using HTTPS
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Backends: console (dev), smtp (Gmail/Mailgun), sendgrid, mailgun API
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@ecitizen.go.ke
SUPPORT_EMAIL=support@ecitizen.go.ke

# ── SMS (Africa's Talking) ────────────────────────────────────────────────────
# Sign up at https://account.africastalking.com to get credentials.
# Sandbox: SMS is simulated, not actually sent. Use sandbox for dev.
AT_USERNAME=sandbox
AT_API_KEY=your-at-api-key
AT_SENDER_ID=eCitizen
AT_ENV=sandbox

# ── M-Pesa Daraja API (Safaricom Mobile Money) ────────────────────────────────
# Register at https://developer.safaricom.co.ke to get credentials.
# sandbox = test environment, production = live M-Pesa.
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_SHORTCODE=174379
MPESA_ENV=sandbox
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_PASSWORD=
# Callback URL base (must be HTTPS and publicly reachable in production)
MPESA_CALLBACK_BASE=https://your-domain.com/api/v1/payments/mpesa/

# ── File Storage (S3 / MinIO) ─────────────────────────────────────────────────
# Default: Django FileSystemStorage (local media/ directory).
# For S3-compatible storage (AWS S3, MinIO, DigitalOcean Spaces), set:
#   DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=ecitizen-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False
AWS_S3_FILE_OVERWRITE=False
AWS_S3_IS_MINIO=False

# ── Sentry / Error Monitoring ─────────────────────────────────────────────────
# DSN from https://sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
# Fraction of transactions to trace (0.0 to 1.0). Start low in production.
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_SEND_DEFAULT_PII=False

# ── Firebase Cloud Messaging (Push Notifications) ─────────────────────────────
# For Android push notifications. Get service account JSON from Firebase Console
# → Project Settings → Service Accounts → Generate New Private Key.
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
# Alternatively, paste the entire JSON as a single line:
FIREBASE_CREDENTIALS_JSON=

# ── News API Keys ─────────────────────────────────────────────────────────────
# Optional — RSS feeds from Kenyan sources work without API keys.
# GNews: https://gnews.io (free tier: 100 req/day)
GNEWS_API_KEY=
# NewsAPI: https://newsapi.org (free tier: 100 req/day, dev only)
NEWSAPI_KEY=

# ── Weather ───────────────────────────────────────────────────────────────────
# Open-Meteo is free and requires no API key.
# Default county code for dashboard weather widget (047 = Nairobi).
DEFAULT_WEATHER_COUNTY=047

# ── Rate Limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=5/minute
REGISTRATION_RATE_LIMIT=3/hour
SEARCH_RATE_LIMIT=30/minute
API_ANON_RATE_LIMIT=60/minute
API_USER_RATE_LIMIT=1000/hour

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_LIVE_NEWS=True
FEATURE_LIVE_WEATHER=True
FEATURE_LIVE_ECONOMIC_DATA=True
FEATURE_MPESA_PAYMENTS=False
FEATURE_SMS_NOTIFICATIONS=False
FEATURE_PUSH_NOTIFICATIONS=False
FEATURE_BIOMETRIC_AUTH=False

# ── Docker Compose ────────────────────────────────────────────────────────────
# These are set automatically by docker-compose.yml, listed here for reference.
# DJANGO_SETTINGS_MODULE=config.settings.dev
# POSTGRES_DB=ecitizen
# POSTGRES_USER=ecitizen
# POSTGRES_PASSWORD=ecitizen_dev
